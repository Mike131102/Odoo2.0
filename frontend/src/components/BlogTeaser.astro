---
import type { BlogPost } from '../types/strapi';

interface Props {
  posts: BlogPost[];
}

const { posts } = Astro.props;

const displayPosts = posts.length > 0 ? posts : [
  { id: 1, documentId: '', title: 'Odoo 17 vs. SAP Business One: Der grosse Vergleich', excerpt: 'Welches ERP-System passt zu Ihrem Unternehmen?', category: 'ERP Vergleich', author: 'Mike Gibert', readingTime: '5 min', publishedAt: new Date().toISOString(), slug: 'odoo-vs-sap', createdAt: '', updatedAt: '' },
  { id: 2, documentId: '', title: '10 Zeichen, dass Ihr Unternehmen ein neues ERP braucht', excerpt: 'Excel-Chaos, fehlende Transparenz – kennen Sie das?', category: 'ERP Beratung', author: 'Mike Gibert', readingTime: '4 min', publishedAt: new Date().toISOString(), slug: '10-zeichen', createdAt: '', updatedAt: '' },
  { id: 3, documentId: '', title: 'Odoo Implementierung: So gelingt der Go-Live', excerpt: 'Best Practices fuer eine erfolgreiche Odoo-Einfuehrung.', category: 'Implementierung', author: 'Mike Gibert', readingTime: '6 min', publishedAt: new Date().toISOString(), slug: 'go-live', createdAt: '', updatedAt: '' },
] as BlogPost[];

function formatDate(dateStr: string) {
  return new Date(dateStr).toLocaleDateString('de-DE', { day: 'numeric', month: 'long', year: 'numeric' });
}

const categoryColors: Record<string, string> = {
  'ERP Vergleich': 'bg-blue-50 text-blue-700',
  'ERP Beratung': 'bg-purple-50 text-purple-700',
  'Implementierung': 'bg-green-50 text-green-700',
};
---

<section id="blog" class="py-20 lg:py-28 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between mb-12">
      <div>
        <span class="text-brand font-semibold text-sm uppercase tracking-wider">Blog & Insights</span>
        <h2 class="section-title mt-2">Aktuelles aus der Odoo-Welt</h2>
      </div>
      <a href="/blog" class="mt-4 sm:mt-0 text-brand font-semibold text-sm hover:underline inline-flex items-center gap-1">
        Alle Artikel
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {displayPosts.map((post, idx) => (
        <article class="card flex flex-col group">
          <div class="flex items-center justify-between mb-4">
            <span class={`text-xs font-semibold px-2 py-1 rounded ${categoryColors[post.category || ''] || 'bg-brand-50 text-brand'}`}>
              {post.category || 'Odoo'}
            </span>
            <span class="text-odoo-muted text-xs">{post.readingTime || '4 min'}</span>
          </div>

          <div class={`h-36 rounded-xl mb-4 flex items-center justify-center ${idx === 0 ? 'bg-gradient-to-br from-brand to-brand-light' : idx === 1 ? 'bg-gradient-to-br from-teal-dark to-teal' : 'bg-gradient-to-br from-brand-800 to-brand-600'}`}>
            <svg class="w-12 h-12 text-white/30" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
            </svg>
          </div>

          <h3 class="font-bold text-odoo-dark text-base leading-snug mb-2 group-hover:text-brand transition-colors flex-grow">
            {post.title}
          </h3>
          <p class="text-odoo-muted text-sm leading-relaxed mb-4 line-clamp-2">{post.excerpt}</p>

          <div class="flex items-center justify-between mt-auto pt-4 border-t border-odoo-border">
            <span class="text-xs text-odoo-muted">{formatDate(post.publishedAt)}</span>
            <a href={`/blog/${post.slug}`} class="text-brand text-xs font-semibold hover:underline">Weiterlesen →</a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>