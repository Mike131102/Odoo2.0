---
interface Props {
  companyName?: string;
  footerText?: string;
  phone?: string;
  email?: string;
  address?: string;
  city?: string;
  postalCode?: string;
  linkedinUrl?: string;
}

const {
  companyName = 'Odoo Beratung Deutschland',
  footerText = 'Professionelle Odoo ERP Beratung und Implementierung fuer den deutschen Mittelstand.',
  phone = '+49 (0) 89 123 456 78',
  email = 'info@odoo-beratung-deutschland.de',
  address = 'Musterstrasse 42',
  city = 'Muenchen',
  postalCode = '80331',
  linkedinUrl,
} = Astro.props;

const currentYear = new Date().getFullYear();

const links = {
  Leistungen: [
    { label: 'Odoo Beratung', href: '#services' },
    { label: 'Odoo Implementierung', href: '#services' },
    { label: 'Odoo Entwicklung', href: '#services' },
    { label: 'Odoo Schulung', href: '#services' },
    { label: 'Odoo Support', href: '#services' },
  ],
  Unternehmen: [
    { label: 'Ueber uns', href: '#about' },
    { label: 'Blog', href: '#blog' },
    { label: 'FAQ', href: '#faq' },
    { label: 'Kontakt', href: '#contact' },
  ],
  Rechtliches: [
    { label: 'Impressum', href: '/impressum' },
    { label: 'Datenschutz', href: '/datenschutz' },
    { label: 'AGB', href: '/agb' },
  ],
};
---

<footer class="bg-odoo-dark text-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-16 pb-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-8 mb-12">
      <!-- Brand Column -->
      <div class="lg:col-span-2">
        <a href="/" class="flex items-center gap-2 mb-4">
          <div class="w-8 h-8 rounded-lg bg-brand flex items-center justify-center">
            <svg class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
          <span class="font-bold text-white text-lg">{companyName}</span>
        </a>
        <p class="text-white/60 text-sm leading-relaxed mb-6 max-w-xs">
          {footerText}
        </p>

        <!-- Contact Info -->
        <div class="space-y-2">
          {phone && (
            <a href={`tel:${phone.replace(/\s/g, '')}`} class="flex items-center gap-2 text-white/60 hover:text-white text-sm transition-colors">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
              </svg>
              {phone}
            </a>
          )}
          {email && (
            <a href={`mailto:${email}`} class="flex items-center gap-2 text-white/60 hover:text-white text-sm transition-colors">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
              {email}
            </a>
          )}
          {address && (
            <div class="flex items-center gap-2 text-white/60 text-sm">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
              {address}, {postalCode} {city}
            </div>
          )}
        </div>

        {linkedinUrl && (
          <div class="mt-6">
            <a href={linkedinUrl} target="_blank" rel="noopener noreferrer" class="w-9 h-9 rounded-lg bg-white/10 flex items-center justify-center hover:bg-brand transition-colors" aria-label="LinkedIn">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
              </svg>
            </a>
          </div>
        )}
      </div>

      <!-- Link Columns -->
      {Object.entries(links).map(([title, items]) => (
        <div>
          <h4 class="font-semibold text-white text-sm mb-4">{title}</h4>
          <ul class="space-y-2">
            {items.map((link) => (
              <li>
                <a href={link.href} class="text-white/60 hover:text-white text-sm transition-colors">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <!-- Bottom Bar -->
    <div class="pt-8 border-t border-white/10 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-white/40 text-xs">
        &copy; {currentYear} {companyName}. Alle Rechte vorbehalten.
      </p>
      <p class="text-white/40 text-xs">
        Realisiert mit Odoo Beratung Deutschland
      </p>
    </div>
  </div>
</footer>
