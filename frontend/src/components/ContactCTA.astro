---
interface Props {
  phone?: string;
  email?: string;
}

const { phone = '+49 (0) 89 123 456 78', email = 'info@odoo-beratung-deutschland.de' } = Astro.props;
---

<section id="contact" class="py-20 lg:py-28 bg-gradient-to-br from-brand-900 via-brand-700 to-brand relative overflow-hidden">
  <!-- Background decoration -->
  <div class="absolute inset-0 opacity-10">
    <div class="absolute top-0 right-0 w-80 h-80 rounded-full bg-white blur-3xl"></div>
    <div class="absolute bottom-0 left-0 w-60 h-60 rounded-full bg-teal blur-3xl"></div>
  </div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid lg:grid-cols-2 gap-16 items-center">
      <!-- Left: CTA -->
      <div class="text-white">
        <span class="text-white/60 font-semibold text-sm uppercase tracking-wider">Kontakt</span>
        <h2 class="text-3xl md:text-4xl font-bold mt-2 mb-6">
          Bereit fuer Ihre Odoo-Transformation?
        </h2>
        <p class="text-white/80 leading-relaxed mb-8">
          Vereinbaren Sie jetzt Ihr kostenloses Erstgespraech. In 45 Minuten analysieren wir
          Ihre Situation und zeigen Ihnen, wie Odoo Ihr Unternehmen voranbringen kann.
        </p>

        <div class="space-y-4">
          {phone && (
            <a href={`tel:${phone.replace(/\s/g, '')}`} class="flex items-center gap-3 text-white/90 hover:text-white transition-colors group">
              <div class="w-10 h-10 rounded-full bg-white/10 flex items-center justify-center group-hover:bg-white/20">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                </svg>
              </div>
              <span class="font-medium">{phone}</span>
            </a>
          )}
          {email && (
            <a href={`mailto:${email}`} class="flex items-center gap-3 text-white/90 hover:text-white transition-colors group">
              <div class="w-10 h-10 rounded-full bg-white/10 flex items-center justify-center group-hover:bg-white/20">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
              </div>
              <span class="font-medium">{email}</span>
            </a>
          )}
        </div>
      </div>

      <!-- Right: Contact Form -->
      <div class="bg-white rounded-3xl p-8 shadow-2xl">
        <h3 class="text-xl font-bold text-odoo-dark mb-6">Kostenlose Erstberatung anfragen</h3>

        <form id="contact-form" class="space-y-4" novalidate>
          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-sm font-medium text-odoo-dark mb-1.5" for="firstname">
                Vorname <span class="text-red-500">*</span>
              </label>
              <input
                id="firstname"
                name="firstname"
                type="text"
                required
                autocomplete="given-name"
                class="w-full px-4 py-2.5 rounded-lg border border-odoo-border text-sm focus:outline-none focus:ring-2 focus:ring-brand focus:border-transparent"
                placeholder="Max"
              />
            </div>
            <div>
              <label class="block text-sm font-medium text-odoo-dark mb-1.5" for="lastname">
                Nachname <span class="text-red-500">*</span>
              </label>
              <input
                id="lastname"
                name="lastname"
                type="text"
                required
                autocomplete="family-name"
                class="w-full px-4 py-2.5 rounded-lg border border-odoo-border text-sm focus:outline-none focus:ring-2 focus:ring-brand focus:border-transparent"
                placeholder="Mustermann"
              />
            </div>
          </div>

          <div>
            <label class="block text-sm font-medium text-odoo-dark mb-1.5" for="email">
              E-Mail <span class="text-red-500">*</span>
            </label>
            <input
              id="email"
              name="email"
              type="email"
              required
              autocomplete="email"
              class="w-full px-4 py-2.5 rounded-lg border border-odoo-border text-sm focus:outline-none focus:ring-2 focus:ring-brand focus:border-transparent"
              placeholder="max.mustermann@firma.de"
            />
          </div>

          <div>
            <label class="block text-sm font-medium text-odoo-dark mb-1.5" for="company">
              Unternehmen
            </label>
            <input
              id="company"
              name="company"
              type="text"
              autocomplete="organization"
              class="w-full px-4 py-2.5 rounded-lg border border-odoo-border text-sm focus:outline-none focus:ring-2 focus:ring-brand focus:border-transparent"
              placeholder="Musterfirma GmbH"
            />
          </div>

          <div>
            <label class="block text-sm font-medium text-odoo-dark mb-1.5" for="message">
              Ihre Anfrage
            </label>
            <textarea
              id="message"
              name="message"
              rows={4}
              class="w-full px-4 py-2.5 rounded-lg border border-odoo-border text-sm focus:outline-none focus:ring-2 focus:ring-brand focus:border-transparent resize-none"
              placeholder="Beschreiben Sie kurz Ihr Projekt oder Ihre Frage..."
            />
          </div>

          <!-- Privacy -->
          <div class="flex items-start gap-3">
            <input
              id="privacy"
              name="privacy"
              type="checkbox"
              required
              class="mt-0.5 w-4 h-4 rounded border-odoo-border text-brand focus:ring-brand"
            />
            <label for="privacy" class="text-xs text-odoo-muted">
              Ich akzeptiere die <a href="/datenschutz" class="text-brand hover:underline">Datenschutzerklaerung</a> und bin einverstanden, dass meine Daten zur Bearbeitung meiner Anfrage gespeichert werden.
            </label>
          </div>

          <button type="submit" class="btn-primary w-full justify-center text-base py-3.5">
            Erstberatung anfragen
            <svg class="ml-2 w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </button>
        </form>

        <div id="form-success" class="hidden text-center py-8">
          <div class="w-16 h-16 rounded-full bg-green-100 flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
            </svg>
          </div>
          <h4 class="text-lg font-bold text-odoo-dark mb-2">Anfrage gesendet!</h4>
          <p class="text-odoo-muted text-sm">Wir melden uns innerhalb von 24 Stunden bei Ihnen.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const success = document.getElementById('form-success');

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    // In production: send to backend API or form service
    // For now: show success state
    form.classList.add('hidden');
    success?.classList.remove('hidden');
  });
</script>
