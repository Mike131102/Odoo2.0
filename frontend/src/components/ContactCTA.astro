---
interface Props {
  phone?: string;
  email?: string;
}
const { phone = '+49 (0) 89 123 456 78', email = 'info@odoo-beratung-deutschland.de' } = Astro.props;
---

<section id="contact" class="py-20 lg:py-28 relative overflow-hidden bg-brand-900">
  <!-- Warm organic blobs -->
  <div class="absolute inset-0 pointer-events-none">
    <div class="absolute top-0 right-0 w-96 h-96 rounded-full bg-brand-700 opacity-50 blur-3xl -translate-y-1/2 translate-x-1/3"></div>
    <div class="absolute bottom-0 left-0 w-72 h-72 rounded-full bg-teal opacity-20 blur-3xl translate-y-1/3 -translate-x-1/4"></div>
    <div class="absolute top-1/2 left-1/2 w-64 h-64 rounded-full bg-sunny opacity-10 blur-3xl -translate-x-1/2 -translate-y-1/2"></div>
    <!-- Scribble decoration -->
    <svg class="absolute top-8 left-8 opacity-20" width="120" height="80" viewBox="0 0 120 80" fill="none">
      <path d="M10 40 Q 30 10 60 35 Q 90 60 110 30" stroke="white" stroke-width="2" stroke-linecap="round" fill="none" stroke-dasharray="5 4"/>
    </svg>
    <svg class="absolute bottom-8 right-8 opacity-20" width="80" height="60" viewBox="0 0 80 60" fill="none">
      <circle cx="40" cy="30" r="25" stroke="white" stroke-width="2" stroke-dasharray="6 4" fill="none"/>
    </svg>
  </div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid lg:grid-cols-2 gap-16 items-center">

      <!-- Left: CTA text -->
      <div class="text-white">
        <div class="inline-flex items-center gap-2 bg-white/10 border border-white/20 px-3 py-1.5 rounded-full text-xs font-semibold mb-6 text-white/80 uppercase tracking-wide">
          ✉️ Kostenlos & unverbindlich
        </div>
        <h2 class="text-3xl md:text-4xl font-bold mb-4 leading-tight">
          Bereit fuer Ihre<br/>
          <span class="relative inline-block">
            Odoo-Transformation?
            <svg class="absolute -bottom-1 left-0 w-full opacity-60" viewBox="0 0 260 8" fill="none">
              <path d="M2 5 Q 65 1 130 5 Q 195 9 258 4" stroke="#FFD166" stroke-width="2.5" stroke-linecap="round" fill="none"/>
            </svg>
          </span>
        </h2>
        <p class="text-white/75 leading-relaxed mb-8 max-w-sm">
          Vereinbaren Sie jetzt Ihr kostenloses Erstgespraech. In 45 Minuten zeigen wir,
          wie Odoo Ihr Unternehmen voranbringen kann — konkret und ohne Floskeln.
        </p>

        <div class="space-y-4">
          {phone && (
            <a href={`tel:${phone.replace(/[\s()]/g, '')}`} class="flex items-center gap-3 text-white/85 hover:text-white group">
              <div class="w-10 h-10 rounded-xl bg-white/10 group-hover:bg-white/20 flex items-center justify-center text-lg transition-colors">📞</div>
              <span class="font-medium">{phone}</span>
            </a>
          )}
          {email && (
            <a href={`mailto:${email}`} class="flex items-center gap-3 text-white/85 hover:text-white group">
              <div class="w-10 h-10 rounded-xl bg-white/10 group-hover:bg-white/20 flex items-center justify-center text-lg transition-colors">✉️</div>
              <span class="font-medium">{email}</span>
            </a>
          )}
        </div>

        <!-- Trust note -->
        <div class="mt-10 flex items-center gap-3 text-white/50 text-xs">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 1l2.928 6.328L20 8.236l-5 4.873 1.18 6.879L10 16.9l-6.18 3.088L5 13.109 0 8.236l7.072-.908L10 1z" clip-rule="evenodd"/>
          </svg>
          <span>Mehr als 50 erfolgreiche Odoo-Projekte · Durchschnittliche Bewertung 4,9/5</span>
        </div>
      </div>

      <!-- Right: Contact form — light card -->
      <div class="bg-white rounded-3xl p-8 shadow-2xl">
        <h3 class="text-xl font-bold text-odoo-dark mb-1">Erstberatung anfragen</h3>
        <p class="text-odoo-muted text-sm mb-6">Antwort innerhalb von 24 Stunden.</p>

        <form id="contact-form" class="space-y-4" novalidate>
          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-semibold text-odoo-dark mb-1.5" for="firstname">Vorname *</label>
              <input id="firstname" name="firstname" type="text" required autocomplete="given-name"
                class="w-full px-4 py-2.5 rounded-xl border border-odoo-border text-sm focus:outline-none focus:ring-2 focus:ring-brand/30 focus:border-brand transition-colors"
                placeholder="Max" />
            </div>
            <div>
              <label class="block text-xs font-semibold text-odoo-dark mb-1.5" for="lastname">Nachname *</label>
              <input id="lastname" name="lastname" type="text" required autocomplete="family-name"
                class="w-full px-4 py-2.5 rounded-xl border border-odoo-border text-sm focus:outline-none focus:ring-2 focus:ring-brand/30 focus:border-brand transition-colors"
                placeholder="Mustermann" />
            </div>
          </div>

          <div>
            <label class="block text-xs font-semibold text-odoo-dark mb-1.5" for="email-contact">E-Mail *</label>
            <input id="email-contact" name="email" type="email" required autocomplete="email"
              class="w-full px-4 py-2.5 rounded-xl border border-odoo-border text-sm focus:outline-none focus:ring-2 focus:ring-brand/30 focus:border-brand transition-colors"
              placeholder="max@firma.de" />
          </div>

          <div>
            <label class="block text-xs font-semibold text-odoo-dark mb-1.5" for="company">Unternehmen</label>
            <input id="company" name="company" type="text" autocomplete="organization"
              class="w-full px-4 py-2.5 rounded-xl border border-odoo-border text-sm focus:outline-none focus:ring-2 focus:ring-brand/30 focus:border-brand transition-colors"
              placeholder="Musterfirma GmbH" />
          </div>

          <div>
            <label class="block text-xs font-semibold text-odoo-dark mb-1.5" for="message">Ihre Anfrage</label>
            <textarea id="message" name="message" rows={3}
              class="w-full px-4 py-2.5 rounded-xl border border-odoo-border text-sm focus:outline-none focus:ring-2 focus:ring-brand/30 focus:border-brand transition-colors resize-none"
              placeholder="Beschreiben Sie kurz Ihr Projekt..."></textarea>
          </div>

          <div class="flex items-start gap-3">
            <input id="privacy" name="privacy" type="checkbox" required
              class="mt-0.5 w-4 h-4 rounded border-odoo-border text-brand focus:ring-brand" />
            <label for="privacy" class="text-xs text-odoo-muted">
              Ich akzeptiere die <a href="/datenschutz" class="text-brand hover:underline">Datenschutzerklaerung</a>.
            </label>
          </div>

          <button type="submit" class="btn-primary w-full justify-center py-3.5">
            Jetzt anfragen ✈️
          </button>
        </form>

        <div id="form-success" class="hidden text-center py-10">
          <div class="text-5xl mb-4">🎉</div>
          <h4 class="text-lg font-bold text-odoo-dark mb-2">Anfrage gesendet!</h4>
          <p class="text-odoo-muted text-sm">Wir melden uns innerhalb von 24 Stunden.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const success = document.getElementById('form-success');
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    form.classList.add('hidden');
    success?.classList.remove('hidden');
  });
</script>