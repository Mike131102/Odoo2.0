---
const strengths = [
  {
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"/></svg>`,
    title: 'Zertifizierter Odoo Partner',
    desc: 'Offiziell zertifiziert – fuer hoehere Qualitaetsstandards und direkten Zugang zu Odoo-Support.'
  },
  {
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>`,
    title: 'Schnelle Implementierung',
    desc: 'Unsere erprobte Methodik liefert in 4–8 Wochen ein produktionsreifes System.'
  },
  {
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/></svg>`,
    title: 'Deutsches Team vor Ort',
    desc: 'Kein Outsourcing – Ihr Ansprechpartner sitzt in Deutschland und spricht Ihre Sprache.'
  },
  {
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>`,
    title: 'DSGVO-konform',
    desc: 'Hosting und Datenhaltung in Deutschland. Alle Prozesse entsprechen der DSGVO.'
  },
  {
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/></svg>`,
    title: 'Messbare Ergebnisse',
    desc: 'Klare KPIs vor Projektstart. Wir liefern, was wir versprechen – im Budget und on time.'
  },
  {
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/></svg>`,
    title: 'Langfristige Partnerschaft',
    desc: 'Wir denken in Partnerschaft, nicht in Projekten. Viele Kunden begleiten uns seit Jahren.'
  },
];
---

<section id="about" class="py-20 lg:py-28 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid lg:grid-cols-2 gap-16 items-center">
      <!-- Left: Text -->
      <div>
        <span class="text-brand font-semibold text-sm uppercase tracking-wider">Warum wir?</span>
        <h2 class="section-title mt-2">
          Odoo-Expertise,<br />die den Unterschied macht
        </h2>
        <p class="text-odoo-muted mt-4 leading-relaxed">
          Wir sind nicht einfach ein weiterer IT-Dienstleister. Wir sind Ihr strategischer Partner
          fuer digitale Transformation – mit fundierter Erfahrung, transparenten Prozessen und
          echter Leidenschaft fuer Odoo.
        </p>

        <div class="mt-8 space-y-4">
          {['Kostenlose Erstberatung ohne Verpflichtung', 'Festes Projektteam – kein Staffing-Wechsel', 'Agile Methodik mit regelmaessigen Reviews', 'Vollstaendige Dokumentation aller Anpassungen'].map((point) => (
            <div class="flex items-start gap-3">
              <div class="w-5 h-5 rounded-full bg-brand flex items-center justify-center flex-shrink-0 mt-0.5">
                <svg class="w-3 h-3 text-white" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                </svg>
              </div>
              <span class="text-odoo-dark font-medium">{point}</span>
            </div>
          ))}
        </div>

        <div class="mt-10">
          <a href="#contact" class="btn-primary">
            Jetzt Beratungsgespraech vereinbaren
          </a>
        </div>
      </div>

      <!-- Right: Strengths Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {strengths.map((s) => (
          <div class="p-5 rounded-2xl bg-odoo-bg hover:bg-brand-50 transition-colors group">
            <div class="w-10 h-10 rounded-lg bg-brand-100 text-brand flex items-center justify-center mb-3 group-hover:bg-brand group-hover:text-white transition-colors">
              <Fragment set:html={s.icon} />
            </div>
            <h3 class="font-semibold text-odoo-dark text-sm mb-1">{s.title}</h3>
            <p class="text-odoo-muted text-xs leading-relaxed">{s.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
