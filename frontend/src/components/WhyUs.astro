---
const strengths = [
  { emoji: '🏆', title: 'Zertifizierter Odoo Partner',  desc: 'Offiziell zertifiziert — direkter Draht zu Odoo-Support und neuesten Updates.' },
  { emoji: '⚡', title: 'Schnelle Implementierung',      desc: 'Unsere Methodik liefert in 4–8 Wochen ein produktionsreifes System.' },
  { emoji: '🇩🇪', title: 'Deutsches Team vor Ort',      desc: 'Kein Outsourcing — Ihr fester Ansprechpartner sitzt in Deutschland.' },
  { emoji: '🔒', title: 'DSGVO-konform',                desc: 'Hosting und Datenhaltung in Deutschland. Alle Prozesse rechtskonform.' },
  { emoji: '📈', title: 'Messbare Ergebnisse',          desc: 'Klare KPIs vor Projektstart. Im Budget und on time — immer.' },
  { emoji: '🤝', title: 'Langfristige Partnerschaft',   desc: 'Wir denken in Partnerschaften, nicht in Projekten. Viele Kunden seit Jahren.' },
];

const bulletPoints = [
  'Kostenlose Erstberatung ohne Verpflichtung',
  'Festes Projektteam – kein Staffing-Wechsel',
  'Agile Methodik mit regelmäßigen Reviews',
  'Vollständige Dokumentation aller Anpassungen',
];
---

<section id="about" class="py-20 lg:py-28 bg-white relative overflow-hidden">
  <!-- Subtle background -->
  <div class="absolute top-0 right-0 w-[500px] h-[500px] rounded-full bg-sunny-50 opacity-30 blur-3xl pointer-events-none -translate-y-1/2 translate-x-1/2" aria-hidden="true"></div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid lg:grid-cols-2 gap-16 items-start">

      <!-- Left: Pitch -->
      <div>
        <span class="inline-block text-brand font-semibold text-xs uppercase tracking-widest mb-3">
          Warum wir?
        </span>
        <h2 class="section-title">
          Odoo-Expertise,<br />
          <span class="relative inline-block">
            die den Unterschied macht
            <svg class="absolute -bottom-1 left-0 w-full" viewBox="0 0 280 7" fill="none" aria-hidden="true">
              <path d="M2 4.5 Q 70 1 140 4.5 Q 210 8 278 3.5" stroke="#F0A500" stroke-width="2" stroke-linecap="round"/>
            </svg>
          </span>
        </h2>

        <p class="text-odoo-muted mt-6 leading-relaxed max-w-md text-[15px]">
          Wir sind nicht einfach ein weiterer IT-Dienstleister. Wir sind Ihr strategischer Partner
          für digitale Transformation – mit fundierter Erfahrung und echter Leidenschaft für Odoo.
        </p>

        <ul class="mt-8 space-y-3" aria-label="Unsere Versprechen">
          {bulletPoints.map((point) => (
            <li class="flex items-start gap-3">
              <span
                class="w-5 h-5 rounded-full bg-teal/10 border border-teal/30 flex items-center justify-center flex-shrink-0 mt-0.5"
                aria-hidden="true"
              >
                <svg class="w-3 h-3 text-teal" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                </svg>
              </span>
              <span class="text-odoo-dark text-sm">{point}</span>
            </li>
          ))}
        </ul>

        <a href="#contact" class="btn-primary mt-10 inline-flex">
          Jetzt Gespräch vereinbaren
        </a>
      </div>

      <!-- Right: Strengths Grid — uniform 2×3 -->
      <div class="grid grid-cols-2 gap-3 mt-2">
        {strengths.map((s) => (
          <div class="group p-4 rounded-xl border border-odoo-border bg-white hover:border-brand/30 hover:bg-brand-50 transition-all duration-200">
            <div class="text-2xl mb-2" aria-hidden="true">{s.emoji}</div>
            <h3 class="font-semibold text-odoo-dark text-sm mb-1 group-hover:text-brand transition-colors leading-snug">
              {s.title}
            </h3>
            <p class="text-odoo-muted text-xs leading-relaxed">{s.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>