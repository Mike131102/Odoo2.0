---
const navLinks = [
  { href: '/#services', label: 'Leistungen' },
  { href: '/#about',   label: 'Ueber uns'  },
  { href: '/#blog',    label: 'Blog'        },
  { href: '/#faq',     label: 'FAQ'         },
  { href: '/#contact', label: 'Kontakt'     },
];
---

<header class="fixed top-0 left-0 right-0 z-50 bg-white/95 backdrop-blur-sm border-b border-odoo-border">
  <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8" aria-label="Hauptnavigation">
    <div class="flex items-center justify-between h-16">

      <!-- Logo -->
      <a href="/" class="flex items-center gap-2.5" aria-label="Odoo Beratung – Startseite">
        <div class="w-8 h-8 rounded-lg bg-brand flex items-center justify-center flex-shrink-0">
          <svg class="w-4 h-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 10V3L4 14h7v7l9-11h-7z"/>
          </svg>
        </div>
        <span class="font-bold text-odoo-dark text-base">
          Odoo <span class="text-brand">Beratung</span>
        </span>
      </a>

      <!-- Desktop links -->
      <ul class="hidden md:flex items-center gap-0.5" role="list">
        {navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class="px-3.5 py-2 rounded-lg text-sm font-medium text-odoo-muted hover:text-brand hover:bg-brand-50 transition-colors"
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>

      <a href="#contact" class="hidden md:inline-flex btn-primary text-xs px-4 py-2">
        Erstberatung anfragen
      </a>

      <!-- Mobile toggle button -->
      <button
        id="mobile-menu-btn"
        class="md:hidden p-2 rounded-lg text-odoo-muted hover:bg-gray-100 transition-colors"
        aria-label="Menue oeffnen"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg id="icon-open"  class="w-5 h-5"         fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
        <svg id="icon-close" class="w-5 h-5 hidden"  fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>

    <!-- Mobile menu — plain disclosure, NOT a dialog -->
    <div id="mobile-menu" class="hidden md:hidden pb-4">
      <ul class="flex flex-col gap-1" role="list">
        {navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class="block px-4 py-2.5 rounded-lg text-sm font-medium text-odoo-muted hover:text-brand hover:bg-brand-50 transition-colors"
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
      <div class="mt-3 px-1">
        <a href="#contact" class="btn-primary w-full justify-center">
          Erstberatung anfragen
        </a>
      </div>
    </div>
  </nav>
</header>

<script>
  const btn   = document.getElementById('mobile-menu-btn') as HTMLButtonElement | null;
  const menu  = document.getElementById('mobile-menu');
  const iconO = document.getElementById('icon-open');
  const iconC = document.getElementById('icon-close');

  function setOpen(open: boolean) {
    menu?.classList.toggle('hidden', !open);
    btn?.setAttribute('aria-expanded', String(open));
    btn?.setAttribute('aria-label', open ? 'Menue schliessen' : 'Menue oeffnen');
    iconO?.classList.toggle('hidden', open);
    iconC?.classList.toggle('hidden', !open);
  }

  btn?.addEventListener('click', () => {
    const isOpen = btn.getAttribute('aria-expanded') === 'true';
    setOpen(!isOpen);
  });

  menu?.querySelectorAll('a').forEach((link) =>
    link.addEventListener('click', () => setOpen(false))
  );
</script>