---
import type { Service } from '../types/strapi';

interface Props {
  services: Service[];
  introTitle?: string;
  introText?: string;
}
const { services, introTitle, introText } = Astro.props;

// Ordered icon config aligned with Strapi service order field
const iconConfig = [
  { emoji: '📊', bg: '#E74C3C' },
  { emoji: '⚙️', bg: '#F39C12' },
  { emoji: '💻', bg: '#2980B9' },
  { emoji: '🎓', bg: '#8E44AD' },
  { emoji: '🛡️', bg: '#27AE60' },
  { emoji: '🔄', bg: '#16A085' },
];

const fallbackServices: Service[] = [
  { id:1, documentId:'', title:'Odoo Beratung & Analyse',        description:'Wir analysieren Ihre Geschäftsprozesse und erarbeiten die optimale Odoo-Strategie – maßgeschneidert für Ihr Unternehmen.',  icon:'chart-bar',    order:1, highlighted:true,  createdAt:'', updatedAt:'' },
  { id:2, documentId:'', title:'Odoo Implementierung',           description:'Professionelle Einführung aller relevanten Odoo-Module – termingerecht und im Budget.',                                        icon:'cog',          order:2, highlighted:false, createdAt:'', updatedAt:'' },
  { id:3, documentId:'', title:'Odoo Entwicklung & Customizing', description:'Individuelle Anpassungen, eigene Module und API-Integrationen – wenn Standardfunktionen nicht ausreichen.',                   icon:'code',         order:3, highlighted:false, createdAt:'', updatedAt:'' },
  { id:4, documentId:'', title:'Odoo Schulung & Training',       description:'Praxisnahe Schulungen für Ihr Team – vor Ort, remote oder als individuelle E-Learning-Kurse.',                                icon:'academic-cap', order:4, highlighted:false, createdAt:'', updatedAt:'' },
  { id:5, documentId:'', title:'Odoo Support & Wartung',         description:'Zuverlässiger Support sowie regelmäßige Updates für einen reibungslosen Betrieb nach dem Go-Live.',                           icon:'support',      order:5, highlighted:false, createdAt:'', updatedAt:'' },
  { id:6, documentId:'', title:'Odoo Migration',                 description:'Sicherer Umstieg von älteren Odoo-Versionen oder anderen ERP-Systemen auf das aktuelle Odoo.',                               icon:'refresh',      order:6, highlighted:false, createdAt:'', updatedAt:'' },
];

const displayServices = Array.isArray(services) && services.length > 0 ? services : fallbackServices;
---

<section id="services" class="py-20 lg:py-28 bg-odoo-bg">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Section header -->
    <div class="text-center mb-14">
      <span class="inline-block text-brand font-semibold text-xs uppercase tracking-widest mb-3">
        Unsere Leistungen
      </span>
      <h2 class="section-title">{introTitle || 'Alles aus einer Hand'}</h2>
      <div class="flex justify-center mt-3 mb-4" aria-hidden="true">
        <svg width="180" height="8" viewBox="0 0 180 8" fill="none">
          <path d="M4 5 Q 45 1 90 5 Q 135 9 176 4" stroke="#F0A500" stroke-width="2" stroke-linecap="round"/>
        </svg>
      </div>
      <p class="section-subtitle mx-auto text-center">
        {introText || 'Von der ersten Beratung bis zum laufenden Support – wir begleiten Sie in jeder Phase Ihres Odoo-Projekts.'}
      </p>
    </div>

    <!-- Services Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
      {displayServices.map((s, i) => {
        const cfg = iconConfig[i % iconConfig.length];
        return (
          <article
            class={`group bg-white rounded-2xl p-6 transition-all duration-200 hover:-translate-y-1 ${
              s.highlighted
                ? 'ring-2 ring-brand/60 shadow-card-hover'
                : 'border border-odoo-border hover:border-brand/30 hover:shadow-card-hover'
            }`}
          >
            <div class="flex items-start justify-between mb-4">
              <div
                class="w-11 h-11 rounded-xl flex items-center justify-center text-xl"
                style={`background-color: ${cfg.bg}18; border: 1.5px solid ${cfg.bg}30;`}
              >
                {cfg.emoji}
              </div>
              {s.highlighted && (
                <span class="text-[11px] font-bold text-sunny-DEFAULT bg-sunny-50 border border-sunny-100 px-2 py-0.5 rounded-full leading-tight">
                  Beliebt
                </span>
              )}
            </div>
            <h3 class="text-sm font-bold text-odoo-dark mb-1.5 group-hover:text-brand transition-colors">
              {s.title}
            </h3>
            <p class="text-odoo-muted text-sm leading-relaxed">
              {s.description}
            </p>
          </article>
        );
      })}
    </div>

    <!-- Inline CTA -->
    <p class="text-center mt-10 text-sm text-odoo-muted">
      Nicht sicher, welche Leistung zu Ihnen passt?{' '}
      <a href="#contact" class="text-brand font-semibold hover:underline">
        Wir beraten Sie kostenlos →
      </a>
    </p>
  </div>
</section>