---
import type { Service } from '../types/strapi';

interface Props {
  services: Service[];
  introTitle?: string;
  introText?: string;
}

const { services, introTitle, introText } = Astro.props;

const iconMap: Record<string, string> = {
  'chart-bar': `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>`,
  'cog': `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>`,
  'code': `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>`,
  'academic-cap': `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path d="M12 14l9-5-9-5-9 5 9 5z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5zm0 0l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14zm-4 6v-7.5l4-2.222"/></svg>`,
  'support': `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z"/></svg>`,
  'refresh': `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>`,
};

const displayServices = services.length > 0 ? services : [
  { id: 1, documentId: '', title: 'Odoo Beratung & Analyse', description: 'Massgeschneiderte ERP-Strategie fuer Ihr Unternehmen.', icon: 'chart-bar', order: 1, highlighted: true, createdAt: '', updatedAt: '' },
  { id: 2, documentId: '', title: 'Odoo Implementierung', description: 'Professionelle Einfuehrung aller relevanten Module.', icon: 'cog', order: 2, highlighted: false, createdAt: '', updatedAt: '' },
  { id: 3, documentId: '', title: 'Odoo Entwicklung', description: 'Individuelle Anpassungen und eigene Module.', icon: 'code', order: 3, highlighted: false, createdAt: '', updatedAt: '' },
  { id: 4, documentId: '', title: 'Odoo Schulung', description: 'Praxisnahe Trainings fuer Ihr Team.', icon: 'academic-cap', order: 4, highlighted: false, createdAt: '', updatedAt: '' },
  { id: 5, documentId: '', title: 'Odoo Support', description: 'Zuverlaessiger Support nach dem Go-Live.', icon: 'support', order: 5, highlighted: false, createdAt: '', updatedAt: '' },
  { id: 6, documentId: '', title: 'Odoo Migration', description: 'Sicherer Umstieg auf neuere Versionen.', icon: 'refresh', order: 6, highlighted: false, createdAt: '', updatedAt: '' },
] as Service[];
---

<section id="services" class="py-20 lg:py-28 bg-odoo-bg">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <span class="text-brand font-semibold text-sm uppercase tracking-wider">Unsere Leistungen</span>
      <h2 class="section-title mt-2">{introTitle || 'Alles aus einer Hand'}</h2>
      <p class="section-subtitle mx-auto">
        {introText || 'Von der ersten Beratung bis zum laufenden Support – wir begleiten Sie in jeder Phase.'}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {displayServices.map((s) => (
        <article class={`card group ${s.highlighted ? 'ring-2 ring-brand' : ''}`}>
          <div class={`w-12 h-12 rounded-xl flex items-center justify-center mb-4 ${s.highlighted ? 'bg-brand text-white' : 'bg-brand-50 text-brand'}`}>
            <Fragment set:html={iconMap[s.icon || 'cog'] || iconMap['cog']} />
          </div>
          {s.highlighted && (
            <span class="inline-block text-xs font-semibold text-brand bg-brand-50 px-2 py-1 rounded mb-2">
              Beliebteste Leistung
            </span>
          )}
          <h3 class="text-lg font-bold text-odoo-dark mb-2 group-hover:text-brand transition-colors">
            {s.title}
          </h3>
          <p class="text-odoo-muted text-sm leading-relaxed">{s.description}</p>
        </article>
      ))}
    </div>
  </div>
</section>