---
interface Props {
  title: string;
  subtitle: string;
  ctaPrimary: string;
  ctaSecondary?: string;
  ctaPrimaryLink?: string;
  ctaSecondaryLink?: string;
}

const {
  title,
  subtitle,
  ctaPrimary,
  ctaSecondary,
  ctaPrimaryLink = '#contact',
  ctaSecondaryLink = '#services',
} = Astro.props;
---

<section class="relative min-h-screen flex items-center overflow-hidden bg-gradient-to-br from-brand-900 via-brand-700 to-brand pt-16">
  <!-- Background pattern -->
  <div class="absolute inset-0 opacity-10">
    <div class="absolute top-20 right-10 w-96 h-96 rounded-full bg-white blur-3xl"></div>
    <div class="absolute bottom-10 left-10 w-64 h-64 rounded-full bg-teal blur-3xl"></div>
    <svg class="absolute inset-0 w-full h-full" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
          <path d="M 40 0 L 0 0 0 40" fill="none" stroke="white" stroke-width="0.5"/>
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#grid)" />
    </svg>
  </div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24 lg:py-32">
    <div class="max-w-4xl">
      <!-- Badge -->
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/10 border border-white/20 text-white/90 text-sm font-medium mb-8">
        <span class="w-2 h-2 rounded-full bg-teal animate-pulse"></span>
        Zertifizierter Odoo Partner Deutschland
      </div>

      <!-- Headline -->
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-white leading-tight mb-6">
        {title}
      </h1>

      <!-- Subtitle -->
      <p class="text-xl text-white/80 leading-relaxed mb-10 max-w-2xl">
        {subtitle}
      </p>

      <!-- CTAs -->
      <div class="flex flex-col sm:flex-row gap-4">
        <a href={ctaPrimaryLink} class="btn-primary bg-white text-brand hover:bg-brand-50 text-base px-8 py-4">
          {ctaPrimary}
          <svg class="ml-2 w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
        {ctaSecondary && (
          <a href={ctaSecondaryLink} class="btn-outline-white text-base px-8 py-4">
            {ctaSecondary}
          </a>
        )}
      </div>

      <!-- Trust Indicators -->
      <div class="mt-16 flex flex-wrap gap-8">
        {[
          { number: '50+', label: 'Projekte abgeschlossen' },
          { number: '10+', label: 'Jahre Erfahrung' },
          { number: '100%', label: 'Kundenzufriedenheit' },
        ].map((stat) => (
          <div class="text-white">
            <div class="text-3xl font-bold">{stat.number}</div>
            <div class="text-white/60 text-sm mt-1">{stat.label}</div>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- Bottom wave -->
  <div class="absolute bottom-0 left-0 right-0">
    <svg viewBox="0 0 1440 80" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M0 80L1440 80L1440 20C1200 60 720 0 0 40V80Z" fill="white"/>
    </svg>
  </div>
</section>
