---
interface Props {
  title: string;
  subtitle: string;
  ctaPrimary: string;
  ctaSecondary?: string;
  ctaPrimaryLink?: string;
  ctaSecondaryLink?: string;
}

const {
  title,
  subtitle,
  ctaPrimary,
  ctaSecondary,
  ctaPrimaryLink = '#contact',
  ctaSecondaryLink = '#services',
} = Astro.props;

// Split title: highlight last two words with yellow marker
const words = title.split(' ');
const highlightStart = Math.max(words.length - 2, 1);
const plainPart  = words.slice(0, highlightStart).join(' ');
const markedPart = words.slice(highlightStart).join(' ');

// Structured Odoo app modules — displayed as a clean grid on the right
const modules = [
  { emoji: '📊', label: 'CRM',          color: '#E74C3C' },
  { emoji: '💰', label: 'Vertrieb',     color: '#F39C12' },
  { emoji: '📦', label: 'Lager',        color: '#27AE60' },
  { emoji: '🧾', label: 'Buchhaltung',  color: '#2980B9' },
  { emoji: '🏢', label: 'Personal',     color: '#8E44AD' },
  { emoji: '✅', label: 'Projekte',     color: '#16A085' },
];
---

<section class="relative overflow-hidden bg-white pt-16">
  <!-- Soft gradient blobs -->
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
    <div class="absolute -top-32 -right-32 w-[600px] h-[600px] rounded-full bg-brand-50 opacity-50 blur-3xl"></div>
    <div class="absolute top-1/2 -left-24 w-72 h-72 rounded-full bg-teal-50 opacity-40 blur-3xl"></div>
  </div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-28">
    <div class="grid lg:grid-cols-2 gap-16 items-center">

      <!-- ── Left column: content ── -->
      <div>
        <!-- Eyebrow -->
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-brand-50 border border-brand-100 text-brand font-semibold text-xs mb-8 uppercase tracking-wide">
          <span class="w-1.5 h-1.5 rounded-full bg-teal animate-pulse" aria-hidden="true"></span>
          Zertifizierter Odoo Partner · Deutschland
        </div>

        <!-- Headline -->
        <h1 class="text-4xl sm:text-5xl lg:text-[3.25rem] font-bold text-odoo-dark leading-[1.15] mb-4">
          {plainPart}
          {' '}
          <span class="relative whitespace-nowrap">
            <span class="relative z-10">{markedPart}</span>
            <!-- Yellow marker highlight -->
            <span
              class="absolute inset-x-0 bottom-1 h-[0.45em] bg-sunny-light opacity-55 -rotate-[0.8deg] rounded"
              aria-hidden="true"
            ></span>
          </span>
        </h1>

        <!-- Wavy accent line -->
        <svg
          class="mb-6 text-sunny-DEFAULT opacity-50"
          width="260" height="10" viewBox="0 0 260 10" fill="none"
          aria-hidden="true"
        >
          <path d="M2 6 Q 65 1 130 6 Q 195 11 258 5" stroke="#F0A500" stroke-width="2.5" stroke-linecap="round"/>
        </svg>

        <!-- Subtitle -->
        <p class="text-lg text-odoo-muted leading-relaxed mb-10 max-w-lg">
          {subtitle}
        </p>

        <!-- CTAs -->
        <div class="flex flex-col sm:flex-row gap-3">
          <a href={ctaPrimaryLink} class="btn-primary text-base px-7 py-3.5 shadow-md hover:shadow-lg">
            {ctaPrimary}
            <svg class="ml-2 w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
            </svg>
          </a>
          {ctaSecondary && (
            <a href={ctaSecondaryLink} class="btn-secondary text-base px-7 py-3.5">
              {ctaSecondary}
            </a>
          )}
        </div>

        <!-- Trust bar -->
        <div class="mt-12 pt-8 border-t border-odoo-border flex flex-wrap gap-8">
          {[
            { n: '50+',  l: 'Projekte abgeschlossen' },
            { n: '10+',  l: 'Jahre Erfahrung' },
            { n: '100%', l: 'Kundenzufriedenheit' },
          ].map((s) => (
            <div>
              <div class="text-2xl font-bold text-odoo-dark tabular-nums">{s.n}</div>
              <div class="text-xs text-odoo-muted mt-0.5">{s.l}</div>
            </div>
          ))}
        </div>
      </div>

      <!-- ── Right column: Odoo app module grid ── -->
      <div class="hidden lg:flex items-center justify-center" aria-hidden="true">
        <!-- Browser-chrome card wrapper -->
        <div class="w-full max-w-md rounded-2xl shadow-2xl overflow-hidden border border-gray-100">
          <!-- Browser chrome bar -->
          <div class="bg-gray-50 border-b border-gray-100 px-4 py-3 flex items-center gap-2">
            <div class="flex gap-1.5">
              <div class="w-3 h-3 rounded-full bg-red-400"></div>
              <div class="w-3 h-3 rounded-full bg-yellow-400"></div>
              <div class="w-3 h-3 rounded-full bg-green-400"></div>
            </div>
            <div class="flex-1 mx-4 bg-white border border-gray-200 rounded-md px-3 py-1 text-xs text-gray-400 font-mono">
              odoo.ihrefirma.de
            </div>
          </div>

          <!-- App grid content -->
          <div class="bg-white p-6">
            <!-- Odoo top bar simulation -->
            <div class="flex items-center justify-between mb-5 pb-4 border-b border-gray-100">
              <div class="flex items-center gap-2">
                <div class="w-6 h-6 rounded bg-brand flex items-center justify-center">
                  <svg class="w-4 h-4 text-white" fill="currentColor" viewBox="0 0 20 20">
                    <path d="M10 2L3 7v11h14V7L10 2z"/>
                  </svg>
                </div>
                <span class="text-xs font-semibold text-gray-700">Meine Apps</span>
              </div>
              <div class="flex items-center gap-2">
                <div class="w-6 h-6 rounded-full bg-brand-50 flex items-center justify-center text-xs font-bold text-brand">M</div>
              </div>
            </div>

            <!-- 2×3 App icon grid -->
            <div class="grid grid-cols-3 gap-3">
              {modules.map((mod) => (
                <div class="group flex flex-col items-center gap-2 p-3 rounded-xl hover:bg-gray-50 transition-colors cursor-default">
                  <div
                    class="w-12 h-12 rounded-xl flex items-center justify-center text-2xl shadow-sm"
                    style={`background-color: ${mod.color}18; border: 1.5px solid ${mod.color}30;`}
                  >
                    {mod.emoji}
                  </div>
                  <span class="text-[10px] font-medium text-gray-600 text-center leading-tight">{mod.label}</span>
                </div>
              ))}
            </div>

            <!-- Bottom status bar -->
            <div class="mt-5 pt-4 border-t border-gray-100 flex items-center justify-between">
              <div class="flex items-center gap-1.5">
                <div class="w-2 h-2 rounded-full bg-teal animate-pulse"></div>
                <span class="text-[10px] text-gray-400">Verbunden · Echtzeit-Sync</span>
              </div>
              <span class="text-[10px] text-gray-300 font-mono">v17.0</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Subtle section divider -->
  <div class="absolute bottom-0 left-0 right-0" aria-hidden="true">
    <svg viewBox="0 0 1440 48" fill="none" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none">
      <path d="M0 48L1440 48L1440 20C1080 44 480 4 0 28V48Z" fill="#FAFAFA"/>
    </svg>
  </div>
</section>