---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { getBlogPosts, getGlobal } from '../../lib/strapi';

const [posts, gl] = await Promise.all([getBlogPosts(20), getGlobal()]);

function formatDate(dateStr: string) {
  return new Date(dateStr).toLocaleDateString('de-DE', {
    day: 'numeric', month: 'long', year: 'numeric',
  });
}

const categoryColors: Record<string, string> = {
  'ERP Vergleich':   'bg-blue-50 text-blue-700',
  'ERP Beratung':    'bg-purple-50 text-purple-700',
  'Implementierung': 'bg-green-50 text-green-700',
};

// Topic-matched Unsplash images per article index
const images = [
  'https://images.unsplash.com/photo-1460925895917-afdab827c52f?w=800&q=80', // ERP/software comparison
  'https://images.unsplash.com/photo-1600880292203-757bb62b4baf?w=800&q=80', // business team
  'https://images.unsplash.com/photo-1553877522-43269d4ea984?w=800&q=80', // project launch
  'https://images.unsplash.com/photo-1542744173-8e7e53415bb0?w=800&q=80', // meeting
  'https://images.unsplash.com/photo-1519389950473-47ba0277781c?w=800&q=80', // tech team
  'https://images.unsplash.com/photo-1486312338219-ce68d2c6f44d?w=800&q=80', // laptop work
];
---

<Layout
  title="Blog – Odoo Beratung Deutschland"
  description="Aktuelle Artikel rund um Odoo ERP, Implementierung und digitale Transformation."
>
  <Nav />
  <main class="pt-24 pb-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

      <div class="text-center mb-14">
        <span class="inline-block text-brand font-semibold text-xs uppercase tracking-widest mb-3">Blog & Insights</span>
        <h1 class="section-title">Aktuelles aus der Odoo-Welt</h1>
        <div class="flex justify-center mt-3 mb-4" aria-hidden="true">
          <svg width="140" height="8" viewBox="0 0 140 8" fill="none">
            <path d="M4 5 Q 35 1 70 5 Q 105 9 136 4" stroke="#F0A500" stroke-width="2" stroke-linecap="round"/>
          </svg>
        </div>
        <p class="section-subtitle mx-auto text-center">Praxiswissen, Erfahrungsberichte und Tipps rund um Odoo ERP.</p>
      </div>

      {posts.length === 0 ? (
        <p class="text-center text-odoo-muted py-20">Keine Artikel gefunden.</p>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {posts.map((post, idx) => (
            <article class="card flex flex-col group overflow-hidden p-0">
              <!-- Cover image -->
              <a href={`/blog/${post.slug}`} class="block overflow-hidden">
                <img
                  src={images[idx % images.length]}
                  alt={post.title}
                  width="800"
                  height="450"
                  loading={idx < 3 ? 'eager' : 'lazy'}
                  class="w-full h-48 object-cover transition-transform duration-300 group-hover:scale-105"
                />
              </a>

              <div class="p-5 flex flex-col flex-grow">
                <div class="flex items-center justify-between mb-3">
                  <span class={`text-xs font-semibold px-2 py-1 rounded-full ${categoryColors[post.category ?? ''] ?? 'bg-brand-50 text-brand'}`}>
                    {post.category ?? 'Odoo'}
                  </span>
                  <span class="text-odoo-muted text-xs">{post.readingTime ?? '4 min'}</span>
                </div>

                <h2 class="font-bold text-odoo-dark text-base leading-snug mb-2 group-hover:text-brand transition-colors flex-grow">
                  <a href={`/blog/${post.slug}`}>{post.title}</a>
                </h2>
                <p class="text-odoo-muted text-sm leading-relaxed mb-4 line-clamp-2">{post.excerpt}</p>

                <div class="flex items-center justify-between mt-auto pt-4 border-t border-odoo-border">
                  <div class="flex items-center gap-2">
                    <div class="w-6 h-6 rounded-full bg-brand-50 flex items-center justify-center text-xs font-bold text-brand">
                      {(post.author ?? 'R')[0]}
                    </div>
                    <span class="text-xs text-odoo-muted">{post.author ?? 'Redaktion'}</span>
                  </div>
                  <time class="text-xs text-odoo-muted" datetime={post.publishedAt}>
                    {formatDate(post.publishedAt)}
                  </time>
                </div>

                <a href={`/blog/${post.slug}`} class="mt-4 btn-primary w-full justify-center text-xs py-2.5">
                  Artikel lesen →
                </a>
              </div>
            </article>
          ))}
        </div>
      )}
    </div>
  </main>
  <Footer
    companyName={gl?.companyName}
    footerText={gl?.footerText}
    phone={gl?.phone}
    email={gl?.email}
    address={gl?.address}
    city={gl?.city}
    postalCode={gl?.postalCode}
    linkedinUrl={gl?.linkedinUrl}
  />
</Layout>